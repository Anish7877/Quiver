/* =======================================================
   GLOBAL BACKGROUNDS & TEXT (DARK MODE)
   Primary: Black | Secondary: Darker Black | Accent: Orange
======================================================== */
QMainWindow {
    background-color: #09090B;
    color: #FAFAFA;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

QWidget#CentralWidget {
    background-color: #09090B;
}

/* Force labels to be transparent so the background shows through cleanly */
QLabel, QCheckBox {
    background-color: transparent;
}
/* =======================================================
   SIDEBAR (Slightly lighter to create depth)
======================================================== */
QFrame#Sidebar {
    background-color: #09090B;
    border-right: 1px solid #27272A;
    border-top-right-radius: 16px;    /* <--- ADDED */
    border-bottom-right-radius: 16px; /* <--- ADDED */
    margin: 0; padding: 0;
}
QFrame#Sidebar QWidget, QFrame#Sidebar QLabel {
    background-color: transparent;
    color: #A1A1AA;
}

/* Sidebar Navigation Buttons */
QPushButton#NavButton, QPushButton#ThemeBtn, QPushButton#HelpBtn, QPushButton#DocsBtn {
    text-align: left;
    padding: 10px 15px;
    border: none;
    border-radius: 6px;
    background-color: transparent;
    color: #A1A1AA;
    font-size: 13px;
    font-weight: 600;
    margin:2px 5px;
}

QPushButton#NavButton:hover, QPushButton#ThemeBtn:hover {
    background-color: #27272A;
    color: #FAFAFA;
}

/* Active Tab Indicator - Orange Accent */
QPushButton#NavButton:checked {
    background-color: rgba(249, 115, 22, 0.15);
    color: #F97316;
    border-left: 3px solid #F97316;
}

QPushButton#AuthBtn {
    text-align: left;
    padding: 8px 15px;
    margin: 0px 5px;
    font-weight: bold;
    border: none;
    color: #F97316;
    background: transparent;
}
QPushButton#AuthBtn:hover {
    color: #FB923C;
}

/* =======================================================
   TOP NAVIGATION BAR
======================================================== */
QFrame#TopNavBar {
    background-color: #09090B;
    border-bottom: 1px solid #27272A;
}

QLineEdit#SearchBox {
    background-color: #18181B; 
    border: 1px solid #3F3F46;
    border-radius: 18px;
    padding: 0px 15px 0px 10px; /* Adjusted padding to accommodate the SVG icon */
    color: #FAFAFA;
    font-size: 13px;
}
QLineEdit:focus {
    border: 1px solid #F97316; /* Orange focus ring */
    background-color: #09090B;
}

QPushButton#SettingsBtn {
    background: transparent;
    color: #A1A1AA;
    font-weight: bold;
    border: none;
    padding: 0px 16px;
    border-radius: 8px;
}
QPushButton#SettingsBtn:hover { color: #FAFAFA; background-color: #27272A; }
QPushButton#SettingsBtn:checked { color: #F97316; background-color: rgba(249, 115, 22, 0.15); }

/* =======================================================
   PRIMARY BUTTONS & TYPOGRAPHY
======================================================== */
QLabel#PageTitle {
    font-size: 28px;
    font-weight: 900;
    color: #FAFAFA;
    letter-spacing: -0.5px;
}

QPushButton#PrimaryButton {
    background-color: #F97316;
    color: #FFFFFF;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: bold;
    font-size: 13px;
    border: none;
}
QPushButton#PrimaryButton:hover {
    background-color: #EA580C;
}

/* =======================================================
   TABLE STYLING (DARK MODE)
======================================================== */
QTableWidget#ResourceTable, QTableWidget#MainTable {
    background-color: #09090B;
    border: 1px solid #27272A; /* ADDED: Outer Outline Border */
    border-radius: 10px;       /* ADDED: Rounded Corners */
    outline: none;
}

QTableWidget#ResourceTable::viewport, QTableWidget#MainTable::viewport {
    background-color: transparent;
}

QTableWidget#ResourceTable::item, QTableWidget#MainTable::item {
    background-color: transparent;
    padding-left: 15px;
    color: #FAFAFA;
    border-right: 1px solid #27272A; /* KEPT: Column separators only */
    border-bottom: none;             /* KEPT: No row separators */
}

QTableWidget#ResourceTable::item:last, QTableWidget#MainTable::item:last {
    border-right: none;
}

QTableWidget#ResourceTable::item:selected, QTableWidget#MainTable::item:selected {
    background-color: rgba(249, 115, 22, 0.15);
    color: #FAFAFA;
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: #18181B;
    font-weight: 800;
    font-size: 12px;
    color: #A1A1AA;
    border: none;
    border-bottom: 2px solid #F97316;
    border-right: 1px solid #27272A;
    padding-left: 15px;
    padding-bottom: 8px;
    padding-top: 8px;
}

/* FIX: Prevent header corners from bleeding out of the rounded table */
QHeaderView::section:first { border-top-left-radius: 9px; }
QHeaderView::section:last  { border-top-right-radius: 9px; border-right: none; }
/* =======================================================
   CARDS (Stats & Containers)
======================================================== */
QFrame#StatPanel, QFrame#ContentCard {
    background-color: #18181B;
    border: 1px solid #27272A;
    border-radius: 12px;
}
QFrame#StatPanel:hover, QFrame#ContentCard:hover {
    border: 1px solid #3F3F46;
}
QLabel#StatLabelTitle { font-size: 11px; font-weight: bold; color: #A1A1AA; letter-spacing: 1px; }
QLabel#StatLabelValue { font-size: 28px; font-weight: 900; color: #FAFAFA; }



/* Sidebar Bottom Buttons */
QPushButton#ProfileBtn {
    text-align: left;
    padding: 8px 15px;
    margin: 2px 5px;
    border: none;
    background-color: transparent;
    color: #FAFAFA; /* Use #09090B for light_style.qss */
    font-size: 13px;
    font-weight: bold; /* Bold to stand out as a user name */
}
QPushButton#ProfileBtn:hover {
    background-color: transparent; /* Keep it static */
}

QPushButton#AuthBtn {
    text-align: left;
    padding: 8px 15px;
    margin: 2px 5px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    color: #F97316; /* Orange Logout text */
    background: transparent;
}
QPushButton#AuthBtn:hover {
    color: #EA580C;
    background-color: rgba(249, 115, 22, 0.1); /* Subtle orange hover box */
    border-radius: 6px;
}


/* =======================================================
   DIALOGS & FORMS (DARK MODE)
======================================================== */
QFrame#PopupFrame {
    background-color: #09090B;
    border: 1px solid #27272A;
    border-radius: 12px;
}

/* Visual / JSON Tab Switcher */
QFrame#ToggleBox {
    background-color: #18181B;
    border: 1px solid #27272A;
    border-radius: 8px;
}


/* Device, Volume, Port Inner Boxes */
QFrame#InnerBox {
    background-color: #18181B;
    border: 1px solid #27272A;
    border-radius: 8px;
}
QLabel#BoxTitle {
    color: #71717A;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 1px;
}
QPushButton#SmallPlusBtn {
    background-color: rgba(249, 115, 22, 0.15); /* Soft orange background */
    color: #F97316;
    border-radius: 11px;
    font-weight: bold;
    font-size: 14px;
    border: none;
    padding-bottom: 2px;
}
QPushButton#SmallPlusBtn:hover {
    background-color: rgba(249, 115, 22, 0.15);
    color: #FFFFFF;
}

/* Form Typography & Editors */
QLabel#SectionTitle { color: #FAFAFA; font-weight: 900; font-size: 13px; letter-spacing: 0.5px; }
QLabel#FormLabel { color: #A1A1AA; font-weight: 600; font-size: 12px; }
QTextEdit#JsonEditor {
    background-color: #18181B;
    border: 1px solid #27272A;
    border-radius: 8px;
    color: #A1A1AA;
    font-family: monospace;
    padding: 15px;
}




/* =======================================================
   BOTTOM SIDEBAR BUTTONS (DARK MODE)
======================================================== */
QPushButton#ThemeBtn {
    text-align: left;
    padding: 10px 15px; /* Matches NavButton */
    margin: 2px 10px;   /* Matches NavButton */
    border: none;
    border-radius: 8px;
    color: #A1A1AA;
    font-size: 13px;
    font-weight: bold;
    background-color: transparent;
    outline: none;
}
QPushButton#ThemeBtn:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #FAFAFA;
}

QPushButton#ProfileBtn {
    text-align: left;
    padding: 10px 15px;
    margin: 2px 10px;
    border: none;
    background-color: transparent;
    color: #FAFAFA; /* Bright white to stand out as the user name */
    font-size: 13px;
    font-weight: bold;
    outline: none;
}

QPushButton#AuthBtn {
    text-align: left;
    padding: 10px 15px;
    margin: 2px 10px;
    border: none;
    border-radius: 8px;
    color: #F97316; /* Orange Logout text */
    font-size: 13px;
    font-weight: bold;
    background-color: transparent;
    outline: none;
}
QPushButton#AuthBtn:hover {
    background-color: rgba(249, 115, 22, 0.15); /* Orange hover tint */
    color: #EA580C;
}

/* =======================================================
   CONTAINER CARD MENU (3-DOTS)
======================================================== */
QPushButton#CardMenu {
    background-color: transparent;
    color: #A1A1AA;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
    padding-bottom: 4px; /* Perfectly vertically centers the 3 dots */
}
QPushButton#CardMenu:hover {
    background-color: #27272A;
    border: 1px solid #3F3F46;
    color: #FAFAFA;
}
/* Quiver Logo Button */
QPushButton#ToggleBtn {
    margin:2px 10px;
    padding : 10px 15px;
    color: #FAFAFA; /* White text for Dark Mode */
    font-weight: 900; 
    font-size: 16px; 
    text-align: left; 
    padding-left: 6px; 
    border: none; 
    background: transparent; 
    border-radius: 6px; 
    padding-top: 8px; 
    padding-bottom: 8px; 
    letter-spacing: 1px;
}
QPushButton#ToggleBtn:hover { 
    background-color: #27272A; 
    color: #F97316; 
}

/* Container Card Title */
QLabel#CardName {
    color: #FAFAFA; /* White text for Container Names */
    font-weight: bold;
    font-size: 14px;
}


/* =======================================================
   TABLE ACTION BUTTONS (DANGER / ALERT) - DARK MODE
======================================================== */
QPushButton#TableDangerBtn {
    background-color: transparent;
    color: #fb7185;
    border: 1px solid rgba(251, 113, 133, 0.5); /* Semi-transparent red border */
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.5px;
}

QPushButton#TableDangerBtn:hover {
    background-color: #fb7185;
    color: #09090B; /* Dark text on bright red background for contrast */
    border: 1px solid #fb7185;
}

QPushButton#TableDangerBtn:pressed {
    background-color: #e11d48;
    border: 1px solid #e11d48;
}

/* =======================================================
   SETTINGS PAGE (DARK MODE)
======================================================== */
QFrame#SettingsGroup { background-color: #18181B; border: 1px solid #27272A; border-radius: 12px; }
QLabel#SettingsGroupTitle { color: #FAFAFA; font-weight: 900; font-size: 13px; letter-spacing: 0.5px; }
QLabel#SettingsLabel { color: #A1A1AA; font-weight: 600; font-size: 13px; }

/* Settings Image Cards */
QToolButton#ThemeLightCard, QToolButton#ThemeDarkCard {
    background-color: #09090B; 
    border: 2px solid #27272A;
    border-radius: 12px;
    color: #A1A1AA;
    font-size: 14px;
    font-weight: bold;
    text-align: center;    /* Forces text to absolute center */
    padding-top: 15px;     /* Pushes the SVG slightly down */
    padding-bottom: 10px;  /* Gives the text breathing room */
}
QToolButton#ThemeLightCard:hover, QToolButton#ThemeDarkCard:hover {
    border: 2px solid #3F3F46;
    color: #FAFAFA;
}



/* =======================================================
   DASHBOARD WIDGETS & CHARTS (DARK MODE)
======================================================== */
QFrame#DashPanel {
    background-color: #18181B;
    border: 1px solid #27272A;
    border-radius: 12px;
}

/* Force QtCharts to stay perfectly transparent inside the panel */
QChartView {
    background: transparent;
    border: none;
}

QLabel#DashPanelTitle {
    color: #FAFAFA; font-size: 16px; font-weight: 900; letter-spacing: 0.5px;
}

/* Quick Launch Cards */
QFrame#DashItemCard {
    background-color: #09090B; border: 1px solid #27272A; border-radius: 8px;
}
QFrame#DashItemCard:hover { border: 1px solid #3F3F46; }
QLabel#DimText { color: #A1A1AA; font-size: 12px; }

/* System Activity Rows */
QFrame#DashEventRow { border-bottom: 1px solid #27272A; }
QFrame#DashEventRow:last-child { border-bottom: none; }

QLabel#EventBadge {
    font-weight: bold; font-size: 10px; padding: 4px 8px; border-radius: 4px; letter-spacing: 1px;
}
QLabel#EventBadge[statTheme="red"]    { color: #fb7185; background: rgba(251, 113, 133, 0.15); }
QLabel#EventBadge[statTheme="green"]  { color: #4ade80; background: rgba(74, 222, 128, 0.15); }
QLabel#EventBadge[statTheme="orange"] { color: #F97316; background: rgba(249, 115, 22, 0.15); }
QLabel#EventBadge[statTheme="white"]  { color: #FAFAFA; background: rgba(255, 255, 255, 0.1); }


/* --- DASHBOARD TEXT COLORS (DARK MODE) --- */
QLabel#ItemName {
    font-weight: bold;
    font-size: 14px;
    color: #FAFAFA; /* Pure white */
}

QLabel#DimText {
    color: #A1A1AA; /* Dimmed light-grey */
    font-size: 12px;
}

QLabel#EventMessage {
    font-size: 13px;
    color: #FAFAFA; /* Pure white */
}


/* =======================================================
   CREATE / DELETE DIALOGS (DARK MODE)
======================================================== */
QDialog#CreateDialog,QDialog#SubDialog{ background-color: #18181B; border: 1px solid #27272A;  }


/* Top Tab Toggle */
QFrame#ToggleBox { background-color: #09090B; border: 1px solid #27272A; border-radius: 8px; }
QPushButton#TabBtn { background: transparent; color: #A1A1AA; border: none; border-radius: 6px; font-size: 12px; font-weight: bold; }
QPushButton#TabBtn:checked { background: #27272A; color: #FAFAFA; }
QPushButton#CloseBtn { background: transparent; color: #A1A1AA; border: none; font-size: 16px; font-weight: bold; }
QPushButton#CloseBtn:hover { color: #ef4444; }

/* Typography */
QLabel#SectionTitle { color: #FAFAFA; font-size: 12px; font-weight: 900; letter-spacing: 1px; }
QLabel#FormLabel, QLabel#ToggleText, QLabel#FileNameLabel { color: #A1A1AA; font-size: 13px; font-weight: bold; }
QLabel#ColonLabel { color: #FAFAFA; font-size: 16px; font-weight: bold; }
QLabel#SliderVal { color: #FAFAFA; font-size: 13px; font-weight: bold; background: #09090B; border: 1px solid #27272A; border-radius: 6px; }

/* Internal List Boxes (Devices, Volumes, Ports) */
QFrame#InnerBox { background: #09090B; border: 1px solid #27272A; border-radius: 8px; }
QLabel#BoxTitle { color: #A1A1AA; font-size: 11px; font-weight: 900; letter-spacing: 0.5px; }
QPushButton#SmallPlusBtn { background: rgba(249, 115, 22, 0.15); color: #F97316; border: 1px solid transparent; border-radius: 4px; font-size: 16px; font-weight: bold; padding-bottom: 2px;}
QPushButton#SmallPlusBtn:hover { background: #F97316; color: #09090B; }

QListWidget#CreateList { background: transparent; border: none; outline: none; }
QListWidget#CreateList::item { font-family: monospace; font-size: 11px; color: #A1A1AA; padding: 4px 0; border-bottom: 1px solid #27272A; }
QListWidget#CreateList::item:selected { color: #F97316; background: transparent; }

/* Text Inputs, Dropdowns, and JSON Editor */
QDialog#CreateDialog QLineEdit, QDialog#CreateDialog QComboBox, QDialog#SubDialog QLineEdit {
    background: #09090B; border: 1px solid #27272A; border-radius: 6px; color: #FAFAFA; padding: 0 10px; font-size: 13px;
}
QDialog#CreateDialog QLineEdit:focus, QDialog#CreateDialog QComboBox:focus { border: 1px solid #F97316; }
QTextEdit#JsonEditor { background: #09090B; border: 1px solid #27272A; border-radius: 8px; color: #A1A1AA; font-family: monospace; padding: 10px; }

/* =======================================================
   SLIDERS (DARK MODE)
======================================================== */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #27272A; /* Dark groove */
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #F97316; /* Orange fill for the selected amount */
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #FAFAFA;
    border: 2px solid #F97316;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 8px; /* Makes it a perfect circle */
}
QSlider::handle:horizontal:hover {
    background: #F97316;
}

/* =======================================================
   SECONDARY BUTTONS (Import JSON, Cancel) - DARK MODE
======================================================== */
QPushButton#SecondaryBtn {
    background-color: transparent;
    border: 1px solid #3F3F46;
    border-radius: 6px;
    color: #A1A1AA;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#SecondaryBtn:hover {
    background-color: #27272A;
    color: #FAFAFA;
    border: 1px solid #71717A;
}
/* =======================================================
   COMBOBOX & DROPDOWN LISTS (DARK MODE)
======================================================== */
QComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox::down-arrow {
    image: none; /* Hides the native GTK arrow */
}
QComboBox QAbstractItemView {
    background-color: #18181B;
    border: 1px solid #27272A;
    border-radius: 6px;
    color: #FAFAFA;
    selection-background-color: rgba(249, 115, 22, 0.15); /* Orange highlight */
    selection-color: #F97316;
    outline: none; /* Removes the dotted focus rectangle */
}

/* Settings Page Profile Section */
QLabel#AvatarDisplay {
    background-color: #09090B;
    border: 2px solid #27272A;
    border-radius: 45px; /* Makes it a perfect circle! */
}
QFrame#SettingsGroup QLineEdit {
    background: #09090B; 
    border: 1px solid #27272A; 
    border-radius: 6px; 
    color: #FAFAFA; 
    padding: 0 10px; 
    font-size: 13px;
}
QFrame#SettingsGroup QLineEdit:focus { border: 1px solid #F97316; }

/* =======================================================
   STAT CARDS (MINIMALIST EDGE - DARK)
======================================================== */
QFrame#StatPanel {
    background-color: #18181B; /* Solid Matte Dark */
    border: 1px solid #27272A; /* Faint outer border */
    border-radius: 6px;
    border-left: 4px solid #3F3F46; /* Default inactive edge */
}

/* Dynamic Left Borders */
QFrame#StatPanel[statTheme="green"]  { border-left-color: #4ade80; }
QFrame#StatPanel[statTheme="red"]    { border-left-color: #fb7185; }
QFrame#StatPanel[statTheme="orange"] { border-left-color: #F97316; }
QFrame#StatPanel[statTheme="white"]  { border-left-color: #FAFAFA; }

QLabel#StatTitle { 
    color: #A1A1AA; 
    font-size: 11px; 
    font-weight: bold; 
    text-transform: uppercase; 
}
QLabel#StatValue { 
    color: #FAFAFA; 
    font-size: 24px; 
    font-weight: bold; 
}

/* =======================================================
   FLOATING ACTION BUTTON (PURE SVG, ENLARGE ON HOVER)
======================================================== */
QPushButton#FabButton {
    background: transparent; 
    border: none;
    qproperty-iconSize: 70px 70px; 
    qproperty-icon: url(":/assets/icons/plus1.png");
}

QPushButton#FabButton:hover {
    qproperty-iconSize: 90px 90px; 
}

QPushButton#FabButton:pressed {
    qproperty-iconSize: 80px 80px; 
}

/* =======================================================
   TABLE ACTION BUTTONS
======================================================== */
QPushButton#BulkActionBtn_play, QPushButton#BulkActionBtn_stop, QPushButton#BulkActionBtn_pause, QPushButton#BulkActionBtn_delete, QPushButton#BulkActionBtn_prune {
    border-radius: 4px;
    background: transparent;
    font-weight: bold;
    font-size: 13px;
    text-align: left;
    padding-left: 10px;
}
QPushButton#BulkActionBtn_prune {
    margin-left: 10px;
}
QPushButton#BulkActionBtn_play, QPushButton#BulkActionBtn_pause { color: #FAFAFA; }
QPushButton#BulkActionBtn_play { border: 1px solid #2ea043; }
QPushButton#BulkActionBtn_play:hover { background: #2ea043; color: white; }

QPushButton#BulkActionBtn_stop, QPushButton#BulkActionBtn_delete, QPushButton#BulkActionBtn_prune { border: 1px solid #f85149; color: #f85149; }
QPushButton#BulkActionBtn_stop:hover, QPushButton#BulkActionBtn_delete:hover, QPushButton#BulkActionBtn_prune:hover { background: #f85149; color: white; }

QPushButton#BulkActionBtn_pause { border: 1px solid #f97316; }
QPushButton#BulkActionBtn_pause:hover { background: #f97316; color: white; }

QPushButton#RowActionBtn_play, QPushButton#RowActionBtn_stop, QPushButton#RowActionBtn_pause, QPushButton#RowActionBtn_delete, QPushButton#RowActionBtn_attach, QPushButton#RowActionBtn_copy, QPushButton#RowActionBtn_info, QPushButton#RowActionBtn_update, QPushButton#RowActionBtn_power {
    border-radius: 4px;
    background: transparent;
}
QPushButton#RowActionBtn_play { border: 1px solid #2ea043; }
QPushButton#RowActionBtn_play:hover { background: #2ea043; }

QPushButton#RowActionBtn_power { border: 1px solid #2ea043; }
QPushButton#RowActionBtn_power:hover { background: #2ea043; }

QPushButton#RowActionBtn_update { border: 1px solid #58a6ff; }
QPushButton#RowActionBtn_update:hover { background: #58a6ff; }

QPushButton#RowActionBtn_pause { border: 1px solid #f97316; }
QPushButton#RowActionBtn_pause:hover { background: #f97316; }

QPushButton#RowActionBtn_stop, QPushButton#RowActionBtn_delete { border: 1px solid #f85149; }
QPushButton#RowActionBtn_stop:hover, QPushButton#RowActionBtn_delete:hover { background: #f85149; }

QPushButton#RowActionBtn_attach { border: 1px solid #58a6ff; }
QPushButton#RowActionBtn_attach:hover { background: #58a6ff; }

QPushButton#RowActionBtn_copy, QPushButton#RowActionBtn_info { border: 1px solid #a1a1aa; }
QPushButton#RowActionBtn_copy:hover, QPushButton#RowActionBtn_info:hover { background: #a1a1aa; }

/* =======================================================
   SCROLLBAR (SLEEK DARK MODE)
======================================================== */
QScrollBar:vertical {
    border: none;
    background: #09090B;
    width: 8px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #27272A;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #3F3F46;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #09090B;
    height: 8px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:horizontal {
    background: #27272A;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #3F3F46;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
