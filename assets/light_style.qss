/* =======================================================
   GLOBAL BACKGROUNDS & TEXT (LIGHT MODE)
   Primary: White | Secondary: Black | Accent: Orange
======================================================== */
QMainWindow {
    background-color: #FFFFFF;
    color: #09090B;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}
QWidget#CentralWidget {
    background-color: #FFFFFF;
}

/* Force labels to be transparent so the background shows through cleanly */
QLabel, QCheckBox {
    background-color: transparent;
}



/* =======================================================
   TOP NAVIGATION BAR
======================================================== */
QFrame#TopNavBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E4E4E7;
}

QLineEdit#SearchBox {
    background-color: #F4F4F5; 
    border: 1px solid #E4E4E7; 
    border-radius: 18px;
    padding: 0px 15px 0px 10px; /* Adjusted padding to accommodate the SVG icon */
    color: #09090B; 
    font-size: 13px;
}
QLineEdit:focus {
    border: 1px solid #F97316; /* Orange focus ring */
    background-color: #FFFFFF;
}

QPushButton#SettingsBtn {
    background: transparent;
    color: #71717A;
    font-weight: bold;
    border: none;
    padding: 0px 16px;
    border-radius: 8px;
}
QPushButton#SettingsBtn:hover { color: #09090B; background-color: #F4F4F5; }
QPushButton#SettingsBtn:checked { color: #EA580C; background-color: rgba(249, 115, 22, 0.08); }

/* =======================================================
   PRIMARY BUTTONS & TYPOGRAPHY
======================================================== */
QLabel#PageTitle {
    font-size: 28px;
    font-weight: 900;
    color: #09090B;
    letter-spacing: -0.5px;
}

QPushButton#PrimaryButton {
    background-color: #F97316;
    color: #FFFFFF;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: bold;
    font-size: 13px;
    border: none;
}
QPushButton#PrimaryButton:hover {
    background-color: #EA580C;
}

/* =======================================================
   TABLE STYLING (LIGHT MODE)
======================================================== */
QTableWidget#ResourceTable, QTableWidget#MainTable {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7; /* Outer Outline Border */
    border-radius: 10px;       /* Rounded Corners */
    outline: none;
}

QTableWidget#ResourceTable::viewport, QTableWidget#MainTable::viewport {
    background-color: transparent;
}

QTableWidget#ResourceTable::item, QTableWidget#MainTable::item {
    background-color: transparent;
    padding-left: 15px;
    color: #09090B; 
    border-right: 1px solid #E4E4E7; /* Column separators only */
    border-bottom: none;             /* No row separators */
}

QTableWidget#ResourceTable::item:last, QTableWidget#MainTable::item:last {
    border-right: none;
}

QTableWidget#ResourceTable::item:selected, QTableWidget#MainTable::item:selected {
    background-color: rgba(249, 115, 22, 0.08); /* Light orange highlight */
    color: #09090B;
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: #FAFAFA; /* Off-white header to separate from main table body */
    font-weight: 800;
    font-size: 12px;
    color: #71717A;
    border: none;
    border-bottom: 2px solid #F97316; /* Keep the orange accent line */
    border-right: 1px solid #E4E4E7;
    padding-left: 15px;
    padding-bottom: 8px;
    padding-top: 8px;
}

/* FIX: Prevent header corners from bleeding out of the rounded table */
QHeaderView::section:first { border-top-left-radius: 9px; }
QHeaderView::section:last  { border-top-right-radius: 9px; border-right: none; }
/* =======================================================
   CARDS (Stats & Containers)
======================================================== */
QFrame#StatPanel, QFrame#ContentCard {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 12px;
}
QFrame#StatPanel:hover, QFrame#ContentCard:hover {
    border: 1px solid #D4D4D8;
    background-color: #FAFAFA;
}
QLabel#StatLabelTitle { font-size: 11px; font-weight: bold; color: #A1A1AA; letter-spacing: 1px; }
QLabel#StatLabelValue { font-size: 28px; font-weight: 900; color: #09090B; }




/* =======================================================
   CONTAINER CARD MENU (3-DOTS)
======================================================== */
QPushButton#CardMenu {
    background-color: transparent;
    color: #71717A;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
    padding-bottom: 4px; /* Perfectly vertically centers the 3 dots */
}
QPushButton#CardMenu:hover {
    background-color: #F4F4F5;
    border: 1px solid #E4E4E7;
    color: #09090B;
}


/* =======================================================
   DIALOGS & FORMS (LIGHT MODE)
======================================================== */
QFrame#PopupFrame {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 12px;
}

/* Visual / JSON Tab Switcher */
QFrame#ToggleBox {
    background-color: #F4F4F5;
    border: 1px solid #E4E4E7;
    border-radius: 8px;
}

/* Device, Volume, Port Inner Boxes */
QFrame#InnerBox {
    background-color: #FAFAFA;
    border: 1px solid #E4E4E7;
    border-radius: 8px;
}
QLabel#BoxTitle {
    color: #A1A1AA;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 1px;
}
QPushButton#SmallPlusBtn {
    background-color: rgba(249, 115, 22, 0.1);
    color: #F97316;
    border-radius: 11px;
    font-weight: bold;
    font-size: 14px;
    border: none;
    padding-bottom: 2px;
}
QPushButton#SmallPlusBtn:hover {
    background-color: rgba(249, 115, 22, 0.1);
    color: #FFFFFF;
}

/* Form Typography & Editors */
QLabel#SectionTitle { color: #09090B; font-weight: 900; font-size: 13px; letter-spacing: 0.5px; }
QLabel#FormLabel { color: #71717A; font-weight: 600; font-size: 12px; }
QTextEdit#JsonEditor {
    background-color: #FAFAFA;
    border: 1px solid #E4E4E7;
    border-radius: 8px;
    color: #3F3F46;
    font-family: monospace;
    padding: 15px;
}


/* =======================================================
   SIDEBAR (LIGHT MODE)
======================================================== */
QFrame#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E4E4E7;
    border-top-right-radius: 8px;    /* <--- ADDED */
    border-bottom-right-radius: 8px; /* <--- ADDED */
    margin: 0px; padding: 0px; 
}

QFrame#Sidebar QWidget, QFrame#Sidebar QLabel {
    background-color: transparent;
    color: #71717A;
}
QPushButton#NavButton, QPushButton#ThemeBtn, QPushButton#HelpBtn, QPushButton#DocsBtn {
    text-align: left;
    padding: 10px 15px; /* Identical to Dark Mode */
    margin: 2px 5px;   /* Identical to Dark Mode */
    border: none;
    border-radius: 6px;
    color: #71717A;
    font-size: 13px;
    font-weight: bold;
    background-color: transparent;
    outline: none;
}
QPushButton#NavButton:hover  {
    background-color: #F4F4F5;
    color: #09090B;
}
QPushButton#NavButton:checked {
    background-color: rgba(249, 115, 22, 0.08); /* Softer orange for light background */
    color: #EA580C; /* Darker orange for white contrast */
    border-top: none; border-right: none; border-bottom: none;
    border-left: 3px solid #EA580C; 
    border-radius: 4px;
    outline: none;
}
QPushButton#NavButton:checked:hover {
    background-color: rgba(249, 115, 22, 0.12); 
}




/* =======================================================
   BOTTOM SIDEBAR BUTTONS (LIGHT MODE)
======================================================== */
QPushButton#ThemeBtn {
    text-align: left;
    padding: 10px 15px; /* Matches NavButton */
    margin: 2px 10px;   /* Matches NavButton */
    border: none;
    border-radius: 8px;
    color: #71717A; /* Medium gray */
    font-size: 13px;
    font-weight: bold;
    background-color: transparent;
    outline: none;
}
QPushButton#ThemeBtn:hover {
    background-color: #F4F4F5; /* Very subtle light gray hover */
    color: #09090B;
}

QPushButton#ProfileBtn {
    text-align: left;
    padding: 10px 15px;
    margin: 2px 10px;
    border: none;
    background-color: transparent;
    color: #09090B; /* Solid black for profile name in light mode */
    font-size: 13px;
    font-weight: bold;
    outline: none;
}

QPushButton#AuthBtn {
    text-align: left;
    padding: 10px 15px;
    margin: 2px 10px;
    border: none;
    border-radius: 8px;
    color: #EA580C; /* Darker orange for strong contrast on white */
    font-size: 13px;
    font-weight: bold;
    background-color: transparent;
    outline: none;
}
QPushButton#AuthBtn:hover {
    background-color: rgba(249, 115, 22, 0.08); /* Soft orange hover tint */
    color: #C2410C;
}

QPushButton#ToggleBtn {
    margin:2px 10px;
    padding:10px 15px;
    color: #09090B; /* Black text for Light Mode */
    font-weight: 900; 
    font-size: 16px; 
    text-align: left; 
    padding-left: 12px; 
    border: none; 
    background: transparent; 
    border-radius: 6px; 
    padding-top: 8px; 
    padding-bottom: 8px; 
    letter-spacing: 1px;
}
QPushButton#ToggleBtn:hover { 
    background-color: #F4F4F5; 
    color: #EA580C; 
}

/* Container Card Title */
QLabel#CardName {
    color: #09090B; /* Black text for Container Names */
    font-weight: bold;
    font-size: 14px;
}


/* =======================================================
   TABLE ACTION BUTTONS (DANGER / ALERT) - LIGHT MODE
======================================================== */
QPushButton#TableDangerBtn {
    background-color: transparent;
    color: #DC2626;
    border: 1px solid rgba(220, 38, 38, 0.4);
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.5px;
}

QPushButton#TableDangerBtn:hover {
    background-color: #DC2626;
    color: #FFFFFF; /* White text on red background */
    border: 1px solid #DC2626;
}

QPushButton#TableDangerBtn:pressed {
    background-color: #B91C1C;
    border: 1px solid #B91C1C;
}

/* =======================================================
   SETTINGS PAGE (LIGHT MODE)
======================================================== */
QFrame#SettingsGroup { background-color: #FFFFFF; border: 1px solid #E4E4E7; border-radius: 12px; }
QLabel#SettingsGroupTitle { color: #09090B; font-weight: 900; font-size: 13px; letter-spacing: 0.5px; }
QLabel#SettingsLabel { color: #71717A; font-weight: 600; font-size: 13px; }

/* Settings Image Cards */
QToolButton#ThemeLightCard, QToolButton#ThemeDarkCard {
    background-color: #FAFAFA; 
    border: 2px solid #E4E4E7;
    border-radius: 12px;
    color: #71717A;
    font-size: 14px;
    font-weight: bold;
    text-align: center;    /* Forces text to absolute center */
    padding-top: 15px;     /* Pushes the SVG slightly down */
    padding-bottom: 10px;  /* Gives the text breathing room */
}
QToolButton#ThemeLightCard:hover, QToolButton#ThemeDarkCard:hover {
    border: 2px solid #D4D4D8;
    color: #09090B;
}





/* =======================================================
   DASHBOARD WIDGETS & CHARTS (LIGHT MODE)
======================================================== */
QFrame#DashPanel {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 12px;
}

/* Force QtCharts to stay perfectly transparent inside the panel */
QChartView {
    background: transparent;
    border: none;
}

QLabel#DashPanelTitle {
    color: #09090B; font-size: 16px; font-weight: 900; letter-spacing: 0.5px;
}

/* Quick Launch Cards */
QFrame#DashItemCard {
    background-color: #FAFAFA; border: 1px solid #E4E4E7; border-radius: 8px;
}
QFrame#DashItemCard:hover { border: 1px solid #D4D4D8; background-color: #FFFFFF; }
QLabel#DimText { color: #71717A; font-size: 12px; }

/* System Activity Rows */
QFrame#DashEventRow { border-bottom: 1px solid #E4E4E7; }
QFrame#DashEventRow:last-child { border-bottom: none; }

QLabel#EventBadge {
    font-weight: bold; font-size: 10px; padding: 4px 8px; border-radius: 4px; letter-spacing: 1px;
}
QLabel#EventBadge[statTheme="red"]    { color: #DC2626; background: rgba(220, 38, 38, 0.1); }
QLabel#EventBadge[statTheme="green"]  { color: #16A34A; background: rgba(22, 163, 74, 0.1); }
QLabel#EventBadge[statTheme="orange"] { color: #EA580C; background: rgba(234, 88, 12, 0.1); }
QLabel#EventBadge[statTheme="white"]  { color: #71717A; background: rgba(9, 9, 11, 0.05); }
/* --- DASHBOARD TEXT COLORS (LIGHT MODE) --- */
QLabel#ItemName {
    font-weight: bold;
    font-size: 14px;
    color: #18181B; /* Dark near-black */
}

QLabel#DimText {
    color: #71717A; /* Medium dark-grey */
    font-size: 12px;
}

QLabel#EventMessage {
    font-size: 13px;
    color: #18181B; /* Dark near-black */
}

/* =======================================================
   CREATE / DELETE DIALOGS (LIGHT MODE)
======================================================== */
QDialog#CreateDialog, QDialog#SubDialog { background-color: #FFFFFF; border: 1px solid #E4E4E7; }

/* Top Tab Toggle */
QFrame#ToggleBox { background-color: #F4F4F5; border: 1px solid #E4E4E7; border-radius: 8px; }
QPushButton#TabBtn { background: transparent; color: #71717A; border: none; border-radius: 6px; font-size: 12px; font-weight: bold; }
QPushButton#TabBtn:checked { background: #FFFFFF; color: #09090B;  }
QPushButton#CloseBtn { background: transparent; color: #71717A; border: none; font-size: 16px; font-weight: bold; }
QPushButton#CloseBtn:hover { color: #DC2626; }

/* Typography */
QLabel#SectionTitle { color: #09090B; font-size: 12px; font-weight: 900; letter-spacing: 1px; }
QLabel#FormLabel, QLabel#ToggleText, QLabel#FileNameLabel { color: #71717A; font-size: 13px; font-weight: bold; }
QLabel#ColonLabel { color: #09090B; font-size: 16px; font-weight: bold; }
QLabel#SliderVal { color: #09090B; font-size: 13px; font-weight: bold; background: #F4F4F5; border: 1px solid #E4E4E7; border-radius: 6px; }

/* Internal List Boxes (Devices, Volumes, Ports) */
QFrame#InnerBox { background: #FAFAFA; border: 1px solid #E4E4E7; border-radius: 8px; }
QLabel#BoxTitle { color: #71717A; font-size: 11px; font-weight: 900; letter-spacing: 0.5px; }
QPushButton#SmallPlusBtn { background: rgba(249, 115, 22, 0.1); color: #EA580C; border: 1px solid transparent; border-radius: 4px; font-size: 16px; font-weight: bold; padding-bottom: 2px;}
QPushButton#SmallPlusBtn:hover { background: #EA580C; color: #FFFFFF; }

QListWidget#CreateList { background: transparent; border: none; outline: none; }
QListWidget#CreateList::item { font-family: monospace; font-size: 11px; color: #71717A; padding: 4px 0; border-bottom: 1px solid #E4E4E7; }
QListWidget#CreateList::item:selected { color: #EA580C; background: transparent; }

/* Text Inputs, Dropdowns, and JSON Editor */
QDialog#CreateDialog QLineEdit, QDialog#CreateDialog QComboBox, QDialog#SubDialog QLineEdit {
    background: #FAFAFA; border: 1px solid #E4E4E7; border-radius: 6px; color: #09090B; padding: 0 10px; font-size: 13px;
}
QDialog#CreateDialog QLineEdit:focus, QDialog#CreateDialog QComboBox:focus { border: 1px solid #EA580C; }
QTextEdit#JsonEditor { background: #FAFAFA; border: 1px solid #E4E4E7; border-radius: 8px; color: #71717A; font-family: monospace; padding: 10px; }

/* =======================================================
   SLIDERS (LIGHT MODE)
======================================================== */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #E4E4E7; /* Light groove */
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #EA580C; /* Darker orange fill */
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 2px solid #EA580C;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 10px; /* Makes it a perfect circle */
}
QSlider::handle:horizontal:hover {
    background: #EA580C;
    border: 2px solid #EA580C;
}

/* =======================================================
   SECONDARY BUTTONS (Import JSON, Cancel) - LIGHT MODE
======================================================== */
QPushButton#SecondaryBtn {
    background-color: transparent;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    color: #71717A;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#SecondaryBtn:hover {
    background-color: #F4F4F5;
    color: #09090B;
    border: 1px solid #A1A1AA;
}

/* =======================================================
   COMBOBOX & DROPDOWN LISTS (LIGHT MODE)
======================================================== */
QComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox::down-arrow {
    image: none; /* Hides the native GTK arrow */
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 6px;
    color: #09090B;
    selection-background-color: rgba(249, 115, 22, 0.08); /* Orange highlight */
    selection-color: #EA580C;
    outline: none; /* Removes the dotted focus rectangle */
}

/* Settings Page Profile Section */
QLabel#AvatarDisplay {
    background-color: #FAFAFA;
    border: 2px solid #E4E4E7;
    border-radius: 45px; /* Makes it a perfect circle! */
}
QFrame#SettingsGroup QLineEdit {
    background: #FAFAFA; 
    border: 1px solid #E4E4E7; 
    border-radius: 6px; 
    color: #09090B; 
    padding: 0 10px; 
    font-size: 13px;
}
QFrame#SettingsGroup QLineEdit:focus { border: 1px solid #EA580C; }

/* =======================================================
   STAT CARDS (MINIMALIST EDGE - LIGHT)
======================================================== */
QFrame#StatPanel {
    background-color: #FFFFFF; /* Pure White */
    border: 1px solid #E4E4E7; /* Faint gray border */
    border-radius: 6px;
    border-left: 4px solid #D4D4D8; /* Default inactive edge */
}

/* Dynamic Left Borders (Slightly darker for Light Mode contrast) */
QFrame#StatPanel[statTheme="green"]  { border-left-color: #22c55e; }
QFrame#StatPanel[statTheme="red"]    { border-left-color: #ef4444; }
QFrame#StatPanel[statTheme="orange"] { border-left-color: #ea580c; }
QFrame#StatPanel[statTheme="white"]  { border-left-color: #09090B; }

QLabel#StatTitle { 
    color: #71717A; 
    font-size: 11px; 
    font-weight: bold; 
    text-transform: uppercase; 
}
QLabel#StatValue { 
    color: #09090B; /* Pure black text */
    font-size: 24px; 
    font-weight: bold; 
}

/* Make the new SVG plus button look clean */
QPushButton#SmallPlusBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
}
QPushButton#SmallPlusBtn:hover {
    background: #E4E4E7;
}
/* =======================================================
   FLOATING ACTION BUTTON (PURE SVG, ENLARGE ON HOVER)
======================================================== */
QPushButton#FabButton {
    background: transparent; /* Removes the ugly orange circle */
    border: none;
    qproperty-iconSize: 70px 70px; 
    qproperty-icon: url(":/assets/icons/plus.png");
   
}
QPushButton#FabButton:hover {
    qproperty-iconSize: 90px 90px; /* SVG smoothly enlarges on hover! */
}

QPushButton#FabButton:pressed {
    qproperty-iconSize: 80px 80px; /* Shrinks slightly when you click it for tactile feedback */
}

/* =======================================================
   TABLE ACTION BUTTONS
======================================================== */
QPushButton#BulkActionBtn_play, QPushButton#BulkActionBtn_stop, QPushButton#BulkActionBtn_pause, QPushButton#BulkActionBtn_delete, QPushButton#BulkActionBtn_prune {
    border-radius: 4px;
    background: transparent;
    font-weight: bold;
    font-size: 13px;
    text-align: left;
    padding-left: 10px;
}
QPushButton#BulkActionBtn_prune {
    margin-left: 10px;
}
QPushButton#BulkActionBtn_play, QPushButton#BulkActionBtn_pause { color: #09090B; }
QPushButton#BulkActionBtn_play { border: 1px solid #2ea043; }
QPushButton#BulkActionBtn_play:hover { background: #2ea043; color: #09090B; }

QPushButton#BulkActionBtn_stop, QPushButton#BulkActionBtn_delete, QPushButton#BulkActionBtn_prune { border: 1px solid #f85149; color: #f85149; }
QPushButton#BulkActionBtn_stop:hover, QPushButton#BulkActionBtn_delete:hover, QPushButton#BulkActionBtn_prune:hover { background: #f85149; color: #09090B; }

QPushButton#BulkActionBtn_pause { border: 1px solid #f97316; }
QPushButton#BulkActionBtn_pause:hover { background: #f97316; color: #09090B; }

QPushButton#RowActionBtn_play, QPushButton#RowActionBtn_stop, QPushButton#RowActionBtn_pause, QPushButton#RowActionBtn_delete, QPushButton#RowActionBtn_attach, QPushButton#RowActionBtn_copy, QPushButton#RowActionBtn_info, QPushButton#RowActionBtn_wait {
    border-radius: 4px;
    background: transparent;
}
QPushButton#RowActionBtn_play { border: 1px solid #2ea043; }
QPushButton#RowActionBtn_play:hover { background: #2ea043; }

QPushButton#RowActionBtn_pause { border: 1px solid #f97316; }
QPushButton#RowActionBtn_pause:hover { background: #f97316; }

QPushButton#RowActionBtn_stop, QPushButton#RowActionBtn_delete { border: 1px solid #f85149; }
QPushButton#RowActionBtn_stop:hover, QPushButton#RowActionBtn_delete:hover { background: #f85149; }

QPushButton#RowActionBtn_attach { border: 1px solid #58a6ff; }
QPushButton#RowActionBtn_attach:hover { background: #58a6ff; }

QPushButton#RowActionBtn_copy, QPushButton#RowActionBtn_info, QPushButton#RowActionBtn_wait { border: 1px solid #a1a1aa; }
QPushButton#RowActionBtn_copy:hover, QPushButton#RowActionBtn_info:hover { background: #a1a1aa; }

QPushButton#RowActionBtn_wait { border: 1px solid #d2a8ff; }
QPushButton#RowActionBtn_wait:hover { background: #d2a8ff; }
